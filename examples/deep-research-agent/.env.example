# The example needs none of this to run — it is scripted, offline, and keyless.
#
# `cp .env.example .env` only when you want one of the cases below. The SDK loads this
# file itself: recorderFromEnv() calls loadEnvFile() before it checks REWIND_ENABLED,
# so a value here can switch recording on without touching the shell.
#
# .env is gitignored at every level, so nothing put here can be committed.
# Set REWIND_ENV_FILE=0 to opt out of the file entirely.

# Record this run. Off means withRewind hands back the original model and tools.
REWIND_ENABLED=1

# Where recordings go. A directory unless REWIND_SERVER is set.
# REWIND_DIR=.rewind

# Send writes to an ingest server instead of a directory. The agent needs no database
# credentials for this — the server holds those.
# REWIND_SERVER=http://localhost:4000
# REWIND_TOKEN=

# Only if you swap ScriptedChatModel for a real provider in src/main.ts. Doing that
# means the run costs money and stops being reproducible offline.
# ANTHROPIC_API_KEY=
